{{/* The alert emails. Colours: red = critical problem, amber = warning, green = resolved. Inline styles only: most
     mail clients ignore <style> blocks. The links (double underscores) are filled by entrypoint.sh. */}}

{{ define "email.title" }}{{ with .CommonAnnotations.title }}{{ . }}{{ else }}{{ .GroupLabels.alertname }}{{ end }}{{ end }}

{{ define "email.subject" }}[MatchLens] {{ if eq .Status "firing" }}PROBLEM{{ else }}RESOLVED{{ end }}: {{ template "email.title" . }}{{ if gt (len .Alerts.Firing) 1 }} ({{ len .Alerts.Firing }}){{ end }}{{ end }}

{{ define "email.where" }}{{ with .Labels.match_id }}Match <b>{{ . }}</b> &nbsp; {{ end }}{{ with .Labels.service }}{{ if ne . "pipeline-exporter" }}Service <b>{{ . }}</b> &nbsp; {{ end }}{{ end }}{{ with .Labels.name }}Container <b>{{ . }}</b> &nbsp; {{ end }}{{ with .Labels.consumer }}Reader <b>{{ . }}</b> &nbsp; {{ end }}{{ with .Labels.dagster_job }}Dagster job <b>{{ . }}</b> &nbsp; {{ end }}{{ with .Labels.layer }}Layer <b>{{ . }}</b> &nbsp; {{ end }}{{ with .Labels.dimension }}Dimension <b>{{ . }}</b>{{ end }}{{ end }}


{{ define "email.alert" }}
<tr><td style="padding:0 0 14px 0">
  {{ if eq .Status "resolved" }}<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#ffffff;border:1px solid #d5dbd3;border-left:6px solid #2e9e5b;border-radius:8px">
  {{ else if eq .Labels.severity "critical" }}<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#ffffff;border:1px solid #d5dbd3;border-left:6px solid #c0392b;border-radius:8px">
  {{ else }}<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#ffffff;border:1px solid #d5dbd3;border-left:6px solid #d97706;border-radius:8px">{{ end }}
    <tr><td style="padding:14px 18px;font-family:Arial,Helvetica,sans-serif;color:#16201a">
      <div style="font-size:16px;font-weight:bold;line-height:1.4">{{ if eq .Status "resolved" }}<span style="color:#2e9e5b">Back to normal.</span> Was: {{ end }}{{ .Annotations.summary }}</div>
      <div style="font-size:14px;line-height:1.5;margin-top:4px;color:#3d4a42">{{ .Annotations.description }}</div>
      <div style="font-size:13px;margin-top:8px;color:#3d4a42">{{ template "email.where" . }}</div>
      {{ if eq .Status "firing" }}
      <div style="margin-top:10px;padding:10px 12px;background:#f3f6f1;border-radius:6px;font-size:14px;line-height:1.5">
        <b>What to check:</b> {{ .Annotations.check }}</div>
      <div style="font-size:12px;margin-top:8px;color:#6b776f">Since {{ .StartsAt.UTC.Format "02 Jan 2006, 15:04 UTC" }}</div>
      {{ else }}
      <div style="font-size:12px;margin-top:8px;color:#6b776f">From {{ .StartsAt.UTC.Format "02 Jan 2006, 15:04" }} to {{ .EndsAt.UTC.Format "15:04 UTC" }}</div>
      {{ end }}
      <div style="margin-top:8px">
        {{ with .Annotations.dashboard }}<a href="__GRAFANA_URL__/d/{{ . }}" style="display:inline-block;margin:4px 8px 0 0;padding:9px 16px;border-radius:6px;background:#146c34;color:#ffffff;font-weight:bold;font-size:14px;text-decoration:none">Open the dashboard</a>{{ end }}
        {{ with .Labels.run_id }}<a href="__DAGSTER_URL__/runs/{{ . }}" style="display:inline-block;margin:4px 8px 0 0;padding:9px 16px;border-radius:6px;background:#146c34;color:#ffffff;font-weight:bold;font-size:14px;text-decoration:none">Open the run in Dagster</a>{{ end }}
        {{ if or (eq .Labels.alertname "SodaCheckFailed") (eq .Labels.alertname "DbtTestFailed") (eq .Labels.alertname "GoldStale") }}<a href="__APP_URL__/data_quality" style="display:inline-block;margin:4px 8px 0 0;padding:9px 16px;border-radius:6px;background:#146c34;color:#ffffff;font-weight:bold;font-size:14px;text-decoration:none">Open the Data quality page</a>{{ end }}
      </div>
    </td></tr>
  </table>
</td></tr>
{{ end }}

{{ define "email.html" }}
<!doctype html><html><body style="margin:0;padding:0;background:#eef1ec">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#eef1ec"><tr><td align="center" style="padding:24px 12px">
<table role="presentation" width="640" cellpadding="0" cellspacing="0" style="max-width:640px;width:100%">
  <tr><td style="padding:0 0 12px 0;font-family:Arial,Helvetica,sans-serif;font-size:15px;font-weight:bold;color:#146c34">MatchLens &middot; monitoring</td></tr>
  <tr><td style="padding:0 0 16px 0">
    {{ if eq .Status "resolved" }}<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#2e9e5b;border-radius:10px">
    {{ else if eq .CommonLabels.severity "critical" }}<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#c0392b;border-radius:10px">
    {{ else }}<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#d97706;border-radius:10px">{{ end }}
      <tr><td style="padding:18px 22px;font-family:Arial,Helvetica,sans-serif;color:#ffffff">
        <div style="font-size:12px;font-weight:bold;letter-spacing:2px">{{ if eq .Status "firing" }}PROBLEM{{ else }}RESOLVED{{ end }}</div>
        <div style="font-size:22px;font-weight:bold;margin-top:4px">{{ template "email.title" . }}</div>
        <div style="font-size:14px;margin-top:6px">{{ if eq .Status "firing" }}{{ len .Alerts.Firing }} active{{ with .Alerts.Resolved }}, {{ len . }} resolved{{ end }}{{ else }}Everything in this group is back to normal.{{ end }}</div>
      </td></tr>
    </table>
  </td></tr>
  {{ range .Alerts.Firing }}{{ template "email.alert" . }}{{ end }}
  {{ range .Alerts.Resolved }}{{ template "email.alert" . }}{{ end }}
  <tr><td style="padding:6px 0 0 0;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:1.6;color:#6b776f">
    <a href="__ALERTMANAGER_URL__" style="color:#146c34">All active alerts</a> &middot; <a href="__GRAFANA_URL__/d/slo" style="color:#146c34">Service levels</a> &middot; <a href="__APP_URL__" style="color:#146c34">MatchLens</a><br>
    Sent by Alertmanager. The links open on the machine running the platform.
  </td></tr>
</table></td></tr></table></body></html>
{{ end }}

{{ define "email.text" }}{{ if eq .Status "firing" }}PROBLEM{{ else }}RESOLVED{{ end }}: {{ template "email.title" . }}
{{ range .Alerts }}
- [{{ .Status }}] {{ .Annotations.summary }}
  {{ .Annotations.description }}{{ if eq .Status "firing" }}
  What to check: {{ .Annotations.check }}{{ end }}{{ with .Annotations.dashboard }}
  Dashboard: __GRAFANA_URL__/d/{{ . }}{{ end }}{{ with .Labels.run_id }}
  Dagster run: __DAGSTER_URL__/runs/{{ . }}{{ end }}
{{ end }}
All active alerts: __ALERTMANAGER_URL__
{{ end }}
