# ---- Images (pinned tags) ----
MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
MINIO_MC_IMAGE=pgsty/mc:RELEASE.2026-09-16T00-00-00Z
KAFKA_IMAGE=apache/kafka:4.3.1
KAFKA_UI_IMAGE=ghcr.io/kafbat/kafka-ui:v1.5.0
SPARK_IMAGE=apache/spark:4.0.0-scala2.13-java17-python3-ubuntu

# ---- MinIO ----
MINIO_ROOT_USER=football_admin
MINIO_ROOT_PASSWORD=football_admin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# One bucket per medallion layer
MINIO_BUCKETS=bronze,silver,gold

# ---- Kafka: topics = name:partitions, comma separated ----
KAFKA_TOPICS=foot-tracking:3,foot-events:1,foot-ball:1,foot-players:1,foot-matches:1
KAFKA_UI_PORT=8081

# ---- Used by the Python scripts on your laptop ----
KAFKA_EXTERNAL_BOOTSTRAP=localhost:29092

# ---- where SkillCorner data is downloaded from ----
SKILLCORNER_REPO=SkillCorner/opendata
SKILLCORNER_REPO_URL=https://github.com/SkillCorner/opendata/blob/master/data/
SKILLCORNER_BRANCH=master

# ---- Spark cluster (Silver) ----
SPARK_MASTER_UI_PORT=8082

# ---- Dashboard ----
APP_PORT=8501
DAGSTER_PORT=3000

# ---- Monitoring (make monitoring): ports on 127.0.0.1, alert emails, Grafana login ----
GRAFANA_PORT=3001
CONTROL_PORT=8000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
# Gmail: SMTP_PASSWORD is an app password, not your Gmail password (monitoring/README.md, "Gmail app password")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.sender@gmail.com
SMTP_PASSWORD=the 16-character app password
ALERT_EMAIL_TO=the address that should receive alerts
# Grafana refuses to start with an empty password (no default admin/admin)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=choose a long password
