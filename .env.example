# ---- Copy to .env and adjust. NEVER commit .env ----

# MinIO (S3-compatible object storage). Password must be >= 8 characters.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_please
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Buckets created automatically at startup
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_WAREHOUSE=warehouse

# Kafka (KRaft, single node)
KAFKA_INTERNAL_BOOTSTRAP=kafka:9092          # from other containers
KAFKA_EXTERNAL_BOOTSTRAP=localhost:29092     # from your laptop (Python scripts)
KAFKA_TOPIC_TRACKING=foot-tracking
KAFKA_TOPIC_EVENTS=foot-events
KAFKA_TRACKING_PARTITIONS=3

# Kafka UI
KAFKA_UI_PORT=8081

# Simulation
MATCH_ID=m001
RANDOM_SEED=42
