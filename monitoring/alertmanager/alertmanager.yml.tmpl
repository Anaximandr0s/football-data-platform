# Alertmanager: who gets which alert, how often. The words between double underscores are filled from .env by
# entrypoint.sh when the container starts (Alertmanager does not read environment variables); the password goes to a
# file, never here.
global:
  smtp_smarthost: "__SMTP_HOST__:__SMTP_PORT__"
  smtp_from: "MatchLens alerts <__SMTP_USER__>"
  smtp_auth_username: "__SMTP_USER__"
  smtp_auth_password_file: /tmp/alertmanager/smtp_password
  smtp_require_tls: true

templates:
  - /tmp/alertmanager/email.tmpl

route:
  receiver: email
  group_by: [alertname, area]     # one email per kind of problem, listing every match or service it touches
  group_wait: 30s                 # wait for the alerts that come together (6 failed checks: one email)
  group_interval: 2m
  repeat_interval: 4h

receivers:
  - name: email
    email_configs:
      - to: "__ALERT_EMAIL_TO__"
        send_resolved: true
        headers:
          Subject: '{{ template "email.subject" . }}'
        html: '{{ template "email.html" . }}'
        text: '{{ template "email.text" . }}'

inhibit_rules:
  # Kafka down explains every lag and streaming alert: send only the cause
  - source_matchers: [alertname="KafkaDown"]
    target_matchers: [area="streaming"]
