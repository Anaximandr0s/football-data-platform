   "title": "Latest run of each job and match",
   "description": "",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "football_dagster_latest_run_failed",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "indexByName": {
       "dagster_job": 0,
       "match_id": 1,
       "run_id": 2,
       "Value": 3
      },
      "renameByName": {
       "dagster_job": "job",
       "match_id": "match",
       "run_id": "run",
       "Value": "result"
      },
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "instance": true,
       "job": true,
       "service": true
      }
     }
    },
    {
     "id": "filterFieldsByName",
     "options": {
      "include": {
       "names": [
        "job",
        "match",
        "run",
        "result"
       ]
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "nothing to show"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "result"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "0": {
            "text": "success",
            "color": "#2e9e5b"
           },
           "1": {
            "text": "failed",
            "color": "#c0392b"
           }
          }
         }
        ]
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   }
