{
 "uid": "streaming",
 "title": "MatchLens · Streaming",
 "description": "A replay seen from Kafka: messages per topic, how far behind each reader is, the Spark Structured Streaming batches and the live delay of the Live page.",
 "tags": [
  "matchlens"
 ],
 "editable": false,
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "timezone": "browser",
 "graphTooltip": 1,
 "panels": [
  {
   "id": 1,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "type": "stat",
   "title": "Replay running",
   "description": "",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "football:replay_running",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "noValue": "no data yet",
     "decimals": null,
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "no replay",
         "color": "#8a948f"
        },
        "1": {
         "text": "replay running",
         "color": "#2e9e5b"
        }
       }
      },
      {
       "type": "special",
       "options": {
        "match": "null+nan",
        "result": {
         "text": "no data yet",
         "color": "#8a948f"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#0072B2",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "center",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
