      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "label_replace({__name__=~\"metrics_streaming_driver_spark_streaming_.+_inputRate_total_Value\"}, \"query\", \"$1\", \"__name__\", \"metrics_streaming_driver_spark_streaming_(.+)_inputRate_total_Value\")",
     "legendFormat": "in · {{query}}",
     "refId": "A"
