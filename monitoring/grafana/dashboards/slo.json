{
 "uid": "slo",
 "title": "MatchLens · Service levels",
 "description": "Five objectives with green or red status.",
 "tags": [
  "matchlens"
 ],
 "editable": false,
 "schemaVersion": 39,
 "version": 1,
 "refresh": "1m",
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "timezone": "browser",
 "graphTooltip": 1,
 "panels": [
  {
   "id": 1,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 3
   },
   "type": "text",
   "title": "Service level objectives",
   "options": {
    "mode": "markdown",
    "content": "Five promises the platform makes, measured over the last 7 days (the retention of Prometheus). **Green**: the promise is kept. **Red**: it is not. The graphs below show how each one moved."
   }
  },
  {
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 3,
    "w": 5,
    "h": 6
   },
   "type": "stat",
   "title": "Live delay p95 · goal < 2 s",
   "description": "95 % of the live messages reach the Live page in under 2 s, over 7 days.",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "slo:live_delay_p95_seconds:7d",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "noValue": "no data yet",
     "decimals": 2,
     "mappings": [
      {
       "type": "special",
       "options": {
        "match": "null+nan",
        "result": {
         "text": "no data yet",
         "color": "#8a948f"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#2e9e5b",
        "value": null
       },
       {
        "color": "#c0392b",
        "value": 2
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "center",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
